# Скопируйте этот шаблон в .env в корне проекта.
# Пустые значения используют defaults из backend/core/config.py, где они есть.
# JWT_SECRET_KEY не имеет default и необходим для аутентификации.
# Переменные окружения имеют приоритет над .env. Реальные секреты не коммитьте.

# Название API в Swagger UI. По умолчанию: MoneyGraph AI.
APP_NAME=

# Разрешённые origins в JSON-массиве, без завершающего /.
# По умолчанию: Vite/dev и запланированный Streamlit.
# ["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8501","http://127.0.0.1:8501"]
# Для будущего деплоя замените пример реальным origin фронтенда со схемой, без пути:
# CORS_ORIGINS=["https://your-frontend.example"]
CORS_ORIGINS=

# PostgreSQL: укажите существующую БД и пользователя с правом создания таблиц.
# Замените USER, PASSWORD, HOST, PORT и DB_NAME своими значениями.
# Спецсимволы в логине/пароле должны быть URL-encoded.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME

# Docker с существующей PostgreSQL на вашем компьютере:
# те же реквизиты, что в DATABASE_URL, но HOST=host.docker.internal.
# Используется только docker-compose.existing-db.yml.
DOCKER_DATABASE_URL=

# Docker Compose: база создаётся контейнером postgres:16 при первом запуске.
# Заполните пароль; DATABASE_URL выше должен использовать те же реквизиты,
# HOST=db и PORT=5432. При локальном запуске Python эти POSTGRES_* не нужны.
POSTGRES_DB=moneygraph
POSTGRES_USER=moneygraph
POSTGRES_PASSWORD=

# Случайный секрет HS256, минимум 32 байта в UTF-8. Не используйте общий пример.
# Генерация в PowerShell перед запуском сервера (в том же окне):
# $env:JWT_SECRET_KEY = .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
# Можно сохранить сгенерированное значение ниже для постоянной настройки.
# Без секрета регистрация, выдача и проверка JWT возвращают 503.
# Неверный логин/пароль, отсутствующий Bearer или другая схема дают 401.
# Health, docs и миграции доступны без секрета.
JWT_SECRET_KEY=

# Срок действия access-токена: положительное целое число минут, default 30.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Публичные auth-эндпоинты: отдельный лимит на один IP, счётчики в памяти процесса.
# Примеры синтаксиса: 10/minute, 100/hour. Превышение даёт 429 и Retry-After.
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute

# Необязательно: отдельная PostgreSQL для проверок миграций.
# TEST_DATABASE_URL читается только из окружения процесса, не из .env:
# $env:TEST_DATABASE_URL = "postgresql+psycopg://USER:PASSWORD@localhost:5432/moneygraph_test"
# Без этой переменной тесты используют SQLite; нужны права на создание схем.
# Не указывайте production-базу.

# analysis/profile_data.py не загружает .env и по-прежнему читает архив
# data (1).zip из родительской папки проекта по фиксированному пути.
